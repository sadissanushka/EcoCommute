        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n  direction TB\n  class Employee {\n    &lt;&lt;external&gt;&gt;\n    +UUID userId\n    +String corporateEmail\n    +boolean isVerified\n    +String gender\n  }\n  class RoadNode {\n    +long nodeId\n    +long osmId\n    +double lat\n    +double lon\n  }\n  class RoadEdge {\n    +long edgeId\n    +double lengthM\n    +double speedKmh\n    +boolean oneWay\n    +double travelTimeS\n  }\n  class RoadGraph {\n    +loadFromOSM(file)\n    +nearestNode(lat, lon) RoadNode\n    +neighbors(nodeId) List~RoadEdge~\n  }\n  class Router {\n    &lt;&lt;interface&gt;&gt;\n    +shortestPath(src, dst, metric) Route\n  }\n  class DijkstraRouter {\n    +shortestPath(src, dst, metric) Route\n  }\n  class AStarRouter {\n    -haversineHeuristic\n    +shortestPath(src, dst, metric) Route\n  }\n  class Route {\n    +List~RoadNode~ path\n    +double distanceM\n    +double etaS\n    +int nodesExpanded\n    +polyline() LineString\n  }\n  class RideOffer {\n    +UUID offerId\n    +Point origin\n    +Point destination\n    +DateTime departAt\n    +int seatsFree\n    +double maxDetourPct\n    +boolean womenOnly\n    +String status\n  }\n  class RideRequest {\n    +UUID requestId\n    +Point origin\n    +Point destination\n    +DateTime windowStart\n    +DateTime windowEnd\n    +boolean womenOnly\n    +String status\n  }\n  class RecurringSchedule {\n    +UUID scheduleId\n    +int daysMask\n    +Time departTime\n    +Date validFrom\n    +Date validTo\n  }\n  class Match {\n    +UUID matchId\n    +double overlapScore\n    +double detourM\n    +double detourPct\n    +String status\n  }\n  class PickupStop {\n    +UUID stopId\n    +int seqNo\n    +Point approxPoint\n  }\n  class MatchingService {\n    +findMatches(offerId) List~Match~\n    +scoreOverlap(offer, request) double\n    +enforceDetourLimit(match) boolean\n    +selectGreedy(matches) List~Match~\n    +applyWomenOnlyFilter(matches) List~Match~\n  }\n  class PickupSequencer {\n    +nearestNeighbour(stops) List~PickupStop~\n    +twoOpt(order) List~PickupStop~\n  }\n  class RouteController {\n    +GET /route\n  }\n  class MatchController {\n    +POST /rides\n    +GET /matches\n  }\n  class RouteBoundary {\n    &lt;&lt;Module 4&gt;&gt;\n    +UUID boundaryId\n    +LineString routeLine\n  }\n\n  Router &lt;|.. DijkstraRouter\n  Router &lt;|.. AStarRouter\n  RoadGraph \&quot;1\&quot; o-- \&quot;*\&quot; RoadNode\n  RoadGraph \&quot;1\&quot; o-- \&quot;*\&quot; RoadEdge\n  RoadEdge \&quot;*\&quot; --&gt; \&quot;2\&quot; RoadNode : connects\n  Router ..&gt; RoadGraph : searches\n  Router ..&gt; Route : returns\n  RouteController ..&gt; Router\n  MatchController ..&gt; MatchingService\n  MatchingService ..&gt; Router : route-cost oracle\n  MatchingService --&gt; PickupSequencer\n  PickupSequencer ..&gt; Router\n  MatchingService \&quot;1\&quot; --&gt; \&quot;*\&quot; Match : creates\n  RideOffer \&quot;1\&quot; -- \&quot;*\&quot; Match\n  RideRequest \&quot;1\&quot; -- \&quot;*\&quot; Match\n  Match \&quot;1\&quot; *-- \&quot;1\&quot; PickupStop\n  RideOffer \&quot;*\&quot; --&gt; \&quot;0..1\&quot; RecurringSchedule\n  RideRequest \&quot;*\&quot; --&gt; \&quot;0..1\&quot; RecurringSchedule\n  Employee \&quot;1\&quot; --&gt; \&quot;*\&quot; RideOffer : posts as driver\n  Employee \&quot;1\&quot; --&gt; \&quot;*\&quot; RideRequest : submits as rider\n  RideOffer ..&gt; RouteBoundary : publishes route&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="dQVXAXmEzEYnNnYyX5l3-1">
