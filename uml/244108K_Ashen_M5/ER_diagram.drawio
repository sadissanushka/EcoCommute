<mxfile host="Electron">
  <diagram name="Page-1" id="xCideidNxBMC6jDWFNqk">
    <mxGraphModel dx="1030" dy="722" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n\ntitle Module 5 - Admin &amp; Government Dashboards\\n+ Analytics/Privacy Engine - ER Diagram\n\nskinparam backgroundColor white\nskinparam shadowing false\nskinparam linetype ortho\n\nhide circle\n\n&#39; ONE SYSTEM BOUNDARY\n\npackage \&quot;Admin &amp; Government Dashboards + Analytics/Privacy Engine\&quot; {\n\n    entity \&quot;Company\&quot; as Company {\n        * company_id : UUID &lt;&lt;PK&gt;&gt;\n        --\n        company_name : VARCHAR\n        data_sharing_consent : BOOLEAN\n    }\n\n    entity \&quot;Department\&quot; as Department {\n        * department_id : UUID &lt;&lt;PK&gt;&gt;\n        --\n        company_id : UUID &lt;&lt;FK&gt;&gt;\n        department_name : VARCHAR\n    }\n\n    entity \&quot;User\&quot; as User {\n        * user_id : UUID &lt;&lt;PK&gt;&gt;\n        --\n        company_id : UUID &lt;&lt;FK&gt;&gt;\n        name : VARCHAR\n        role : VARCHAR\n        email : VARCHAR\n    }\n\n    entity \&quot;Department_Analytics\&quot; as Analytics {\n        * analytics_id : UUID &lt;&lt;PK&gt;&gt;\n        --\n        department_id : UUID &lt;&lt;FK&gt;&gt;\n        total_trips : INT\n        occupancy_rate : DECIMAL\n        fuel_reimbursed : DECIMAL\n        total_co2 : DECIMAL\n        avoided_co2 : DECIMAL\n        report_date : DATE\n    }\n\n    entity \&quot;City_Zone\&quot; as Zone {\n        * zone_id : UUID &lt;&lt;PK&gt;&gt;\n        --\n        zone_name : VARCHAR\n        zone_geometry : GEOMETRY\n    }\n\n    entity \&quot;City_Analytics\&quot; as CityAnalytics {\n        * city_analytics_id : UUID &lt;&lt;PK&gt;&gt;\n        --\n        zone_id : UUID &lt;&lt;FK&gt;&gt;\n        total_commutes : INT\n        average_occupancy : DECIMAL\n        total_co2 : DECIMAL\n        report_date : DATE\n    }\n\n    entity \&quot;Privacy_Budget\&quot; as Budget {\n        * budget_id : UUID &lt;&lt;PK&gt;&gt;\n        --\n        total_epsilon : DECIMAL\n        used_epsilon : DECIMAL\n        remaining_epsilon : DECIMAL\n    }\n\n    entity \&quot;Privacy_Query\&quot; as Query {\n        * query_id : UUID &lt;&lt;PK&gt;&gt;\n        --\n        budget_id : UUID &lt;&lt;FK&gt;&gt;\n        user_id : UUID &lt;&lt;FK&gt;&gt;\n        epsilon_used : DECIMAL\n        query_date : TIMESTAMP\n    }\n\n    entity \&quot;Report\&quot; as Report {\n        * report_id : UUID &lt;&lt;PK&gt;&gt;\n        --\n        company_id : UUID &lt;&lt;FK&gt;&gt;\n        user_id : UUID &lt;&lt;FK&gt;&gt;\n        report_type : VARCHAR\n        file_format : VARCHAR\n        generated_at : TIMESTAMP\n    }\n\n    &#39; RELATIONSHIPS\n\n    Company ||--o{ Department : contains\n\n    Company ||--o{ User : employs\n\n    Department ||--o{ Analytics : generates\n\n    Zone ||--o{ CityAnalytics : contains\n\n    Budget ||--o{ Query : tracks\n\n    User ||--o{ Query : submits\n\n    Company ||--o{ Report : has\n\n    User ||--o{ Report : generates\n\n}\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="HpXhnYdnI1WNcZEtV5xZ-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
