        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n\nleft to right direction\n\nskinparam shadowing false\nskinparam backgroundColor white\nskinparam packageStyle rectangle\n\ntitle Admin &amp; Government Dashboards + Analytics/Privacy Engine\n\n&#39; Actors\nactor \&quot;Company Administrator\&quot; as Admin\nactor \&quot;Government Policymaker\&quot; as Gov\nactor \&quot;System Scheduler\&quot; as Scheduler\n\n&#39; Single System Boundary\nrectangle \&quot;Admin &amp; Government Dashboards + Analytics/Privacy Engine\&quot; {\n\n    &#39; Admin Dashboard\n    usecase \&quot;View Company Dashboard\&quot; as UC1\n    usecase \&quot;View Trip &amp; Occupancy Statistics\&quot; as UC2\n    usecase \&quot;View Fuel &amp; CO2 Analytics\&quot; as UC3\n    usecase \&quot;Filter Analytics\&quot; as UC4\n    usecase \&quot;Export Reports (CSV/PDF)\&quot; as UC5\n    usecase \&quot;Manage Data Sharing Consent\&quot; as UC6\n\n    &#39; Government Dashboard\n    usecase \&quot;View Government Dashboard\&quot; as UC7\n    usecase \&quot;View City-Level Analytics\&quot; as UC8\n    usecase \&quot;View Commute Heatmaps\&quot; as UC9\n\n    &#39; Analytics Engine\n    usecase \&quot;Aggregate Commuting Data\&quot; as UC10\n    usecase \&quot;Refresh Analytics Data\&quot; as UC11\n\n    &#39; Privacy Engine\n    usecase \&quot;Generate Privacy-Protected Data\&quot; as UC12\n    usecase \&quot;Apply K-Anonymity\&quot; as UC13\n    usecase \&quot;Apply Differential Privacy\&quot; as UC14\n    usecase \&quot;Manage Privacy Budget\&quot; as UC15\n\n}\n\n&#39; Admin Relationships\nAdmin --&gt; UC1\nAdmin --&gt; UC4\nAdmin --&gt; UC5\nAdmin --&gt; UC6\n\nUC1 ..&gt; UC2 : &lt;&lt;include&gt;&gt;\nUC1 ..&gt; UC3 : &lt;&lt;include&gt;&gt;\n\n&#39; Government Relationships\nGov --&gt; UC7\n\nUC7 ..&gt; UC8 : &lt;&lt;include&gt;&gt;\nUC7 ..&gt; UC9 : &lt;&lt;include&gt;&gt;\nUC7 ..&gt; UC12 : &lt;&lt;include&gt;&gt;\n\n&#39; Analytics Relationships\nScheduler