        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n\ntitle Module 5 - Admin &amp; Government Dashboards\\n+ Analytics/Privacy Engine\n\nskinparam backgroundColor white\nskinparam shadowing false\n\nstart\n\n:User Login;\n\n:Authenticate User;\n\nif (Valid User?) then (Yes)\n\n    :Identify User Role;\n\n    if (Company Administrator?) then (Yes)\n\n        :Open Admin Dashboard;\n\n        :Retrieve Company Analytics;\n\n        :View Trip, Occupancy,\\nFuel and CO2 Statistics;\n\n        if (Apply Filters?) then (Yes)\n            :Select Date Range / Department;\n            :Display Filtered Analytics;\n        else (No)\n        endif\n\n        if (Export Report?) then (Yes)\n            :Generate CSV / PDF Report;\n            :Download Report;\n        else (No)\n        endif\n\n    else (Government Policymaker)\n\n        :Open Government Dashboard;\n\n        :Select City Zone and Date Range;\n\n        :Check Data Sharing Consent;\n\n        if (Consent Available?) then (Yes)\n\n            :Retrieve Aggregated City Data;\n\n            :Apply K-Anonymity;\n\n            :Check Privacy Budget;\n\n            if (Budget Available?) then (Yes)\n\n                :Apply Differential Privacy;\n\n                :Update Privacy Budget;\n\n                :Display City Analytics\\nand Commute Heatmaps;\n\n            else (No)\n\n                :Display Privacy Budget\\nExceeded Message;\n\n            endif\n\n        else (No)\n\n            :Display No Available Data;\n\n        endif\n\n    endif\n\nelse (No)\n\n    :Display Login Failed Message;\n\nendif\n\nstop\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="-NwzpLD3XXj0cw0U7Uzq-1">
