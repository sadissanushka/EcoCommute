      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n\ntitle Fleet &amp; Shuttle Booking + Intelligent Seat Allocation\ntitle Class Diagram\n\nskinparam classAttributeIconSize 0\nskinparam shadowing false\n\nclass Employee {\n    - employeeId : int\n    - name : String\n    - email : String\n    - password : String\n    + searchTrips()\n    + bookSeat()\n    + cancelBooking()\n    + viewBookings()\n}\n\nclass Admin {\n    - adminId : int\n    - name : String\n    - email : String\n    + manageVehicles()\n    + manageTrips()\n    + viewReports()\n}\n\nclass Vehicle {\n    - vehicleId : int\n    - vehicleNumber : String\n    - capacity : int\n    - vehicleType : String\n    + updateVehicle()\n    + getAvailableSeats()\n}\n\nclass ShuttleTrip {\n    - tripId : int\n    - route : String\n    - departureTime : DateTime\n    - arrivalTime : DateTime\n    - availableSeats : int\n    + checkAvailability()\n    + updateTrip()\n}\n\nclass Seat {\n    - seatId : int\n    - seatNumber : String\n    - status : String\n    + checkStatus()\n    + updateStatus()\n}\n\nclass Booking {\n    - bookingId : int\n    - bookingDate : DateTime\n    - seatCount : int\n    - status : String\n    + confirmBooking()\n    + modifyBooking()\n    + cancelBooking()\n}\n\nclass SeatAllocation {\n    - allocationId : int\n    + checkAvailableSeats()\n    + findAdjacentSeats()\n    + allocateIndividualSeats()\n    + preventDoubleBooking()\n}\n\nclass Waitlist {\n    - waitlistId : int\n    - requestedSeats : int\n    - joinedAt : DateTime\n    - status : String\n    + addToWaitlist()\n    + removeFromWaitlist()\n    + promoteEmployee()\n}\n\n&#39; Relationships\n\nEmployee \&quot;1\&quot; -- \&quot;0..*\&quot; Booking : makes\n\nEmployee \&quot;1\&quot; -- \&quot;0..*\&quot; Waitlist : joins\n\nAdmin \&quot;1\&quot; -- \&quot;0..*\&quot; Vehicle : manages\n\nAdmin \&quot;1\&quot; -- \&quot;0..*\&quot; ShuttleTrip : manages\n\nVehicle \&quot;1\&quot; *-- \&quot;1..*\&quot; Seat : contains\n\nVehicle \&quot;1\&quot; -- \&quot;0..*\&quot; ShuttleTrip : assigned to\n\nShuttleTrip \&quot;1\&quot; -- \&quot;0..*\&quot; Booking : has\n\nShuttleTrip \&quot;1\&quot; -- \&quot;0..*\&quot; Waitlist : maintains\n\nBooking \&quot;1\&quot; -- \&quot;1..*\&quot; Seat : reserves\n\nSeatAllocation ..&gt; Booking : processes\n\nSeatAllocation ..&gt; Seat : allocates\n\nSeatAllocation ..&gt; Waitlist : promotes\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="qzBMG23U0_PtDt5GlKwQ-232">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
