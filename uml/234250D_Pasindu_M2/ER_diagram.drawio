  <diagram name="Page-1" id="qzii8xKSr5GWcY6Epqlt">
    <mxGraphModel dx="1493" dy="1046" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n\ntitle Fleet &amp; Shuttle Booking + Intelligent Seat Allocation\ntitle ER Diagram\n\nhide circle\nskinparam linetype ortho\nskinparam shadowing false\n\nentity \&quot;Employee\&quot; as Employee {\n    * employee_id : INT &lt;&lt;PK&gt;&gt;\n    --\n    name : VARCHAR\n    email : VARCHAR\n    password : VARCHAR\n}\n\nentity \&quot;Admin\&quot; as Admin {\n    * admin_id : INT &lt;&lt;PK&gt;&gt;\n    --\n    name : VARCHAR\n    email : VARCHAR\n}\n\nentity \&quot;Vehicle\&quot; as Vehicle {\n    * vehicle_id : INT &lt;&lt;PK&gt;&gt;\n    --\n    vehicle_number : VARCHAR\n    vehicle_type : VARCHAR\n    capacity : INT\n}\n\nentity \&quot;Shuttle_Trip\&quot; as Trip {\n    * trip_id : INT &lt;&lt;PK&gt;&gt;\n    --\n    vehicle_id : INT &lt;&lt;FK&gt;&gt;\n    route : VARCHAR\n    departure_time : DATETIME\n    arrival_time : DATETIME\n    status : VARCHAR\n}\n\nentity \&quot;Seat\&quot; as Seat {\n    * seat_id : INT &lt;&lt;PK&gt;&gt;\n    --\n    vehicle_id : INT &lt;&lt;FK&gt;&gt;\n    seat_number : VARCHAR\n}\n\nentity \&quot;Booking\&quot; as Booking {\n    * booking_id : INT &lt;&lt;PK&gt;&gt;\n    --\n    employee_id : INT &lt;&lt;FK&gt;&gt;\n    trip_id : INT &lt;&lt;FK&gt;&gt;\n    booking_date : DATETIME\n    seat_count : INT\n    status : VARCHAR\n}\n\nentity \&quot;Seat_Assignment\&quot; as Assignment {\n    * assignment_id : INT &lt;&lt;PK&gt;&gt;\n    --\n    booking_id : INT &lt;&lt;FK&gt;&gt;\n    seat_id : INT &lt;&lt;FK&gt;&gt;\n}\n\nentity \&quot;Waitlist\&quot; as Waitlist {\n    * waitlist_id : INT &lt;&lt;PK&gt;&gt;\n    --\n    employee_id : INT &lt;&lt;FK&gt;&gt;\n    trip_id : INT &lt;&lt;FK&gt;&gt;\n    requested_seats : INT\n    joined_at : DATETIME\n    status : VARCHAR\n}\n\n&#39; Relationships\n\nVehicle ||--o{ Trip : operates\n\nVehicle ||--|{ Seat : contains\n\nEmployee ||--o{ Booking : makes\n\nTrip ||--o{ Booking : has\n\nBooking ||--|{ Assignment : contains\n\nSeat ||--o{ Assignment : assigned_to\n\nEmployee ||--o{ Waitlist : joins\n\nTrip ||--o{ Waitlist : maintains\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="qzBMG23U0_PtDt5GlKwQ-468">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=70 83 10 30;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
