      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n\ntitle Fleet &amp; Shuttle Booking + Intelligent Seat Allocation\ntitle Sequence Diagram\n\nautonumber\n\nactor Employee\nparticipant \&quot;Booking UI\&quot; as UI\nparticipant \&quot;Booking Controller\&quot; as BC\nparticipant \&quot;Shuttle Trip Service\&quot; as TS\nparticipant \&quot;Seat Allocation Engine\&quot; as SA\nparticipant \&quot;Waitlist Manager\&quot; as WM\ndatabase \&quot;Database\&quot; as DB\n\n== Search Shuttle Trips ==\n\nEmployee -&gt; UI : Search Shuttle Trips\nUI -&gt; BC : searchTrips()\nBC -&gt; TS : getAvailableTrips()\nTS -&gt; DB : Fetch Shuttle Trips\nDB --&gt; TS : Trip List\nTS --&gt; BC : Available Trips\nBC --&gt; UI : Display Trips\nUI --&gt; Employee : Show Available Trips\n\n== Book Shuttle Seat ==\n\nEmployee -&gt; UI : Select Trip and Request Seats\nUI -&gt; BC : createBooking(tripId, seatCount)\n\nBC -&gt; TS : checkSeatAvailability()\nTS -&gt; DB : Check Available Seats\nDB --&gt; TS : Available Seat Count\nTS --&gt; BC : Availability Result\n\nalt Seats Available\n\n    BC -&gt; SA : allocateSeats(tripId, seatCount)\n\n    SA -&gt; DB : Get Available Seats\n    DB --&gt; SA : Seat List\n\n    alt Adjacent Seats Available\n        SA -&gt; SA : Allocate Adjacent Seats\n    else Adjacent Seats Unavailable\n        SA -&gt; SA : Allocate Individual Seats\n    end\n\n    SA -&gt; DB : Save Booking and Seat Assignment\n    DB --&gt; SA : Booking Saved\n\n    SA --&gt; BC : Allocation Successful\n    BC --&gt; UI : Booking Confirmed\n    UI --&gt; Employee : Display Confirmation\n\nelse Seats Unavailable\n\n    BC --&gt; UI : Trip Fully Booked\n    UI --&gt; Employee : Offer Waitlist\n\n    opt Employee Joins Waitlist\n        Employee -&gt; UI : Join Waitlist\n        UI -&gt; BC : joinWaitlist()\n        BC -&gt; WM : addToWaitlist()\n        WM -&gt; DB : Save Waitlist Entry\n        DB --&gt; WM : Entry Saved\n        WM --&gt; BC : Waitlist Confirmed\n        BC --&gt; UI : Show Waitlist Status\n        UI --&gt; Employee : Display Waitlist Confirmation\n    end\n\nend\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="qzBMG23U0_PtDt5GlKwQ-400">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
