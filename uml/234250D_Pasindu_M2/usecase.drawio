        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nleft to right direction\nskinparam shadowing false\nskinparam nodesep 40\nskinparam ranksep 90\nskinparam usecase {\n  BackgroundColor #FFFFFF\n  BorderColor #333333\n}\n\n&#39; ---------- Primary actors (left) ----------\nactor \&quot;User\&quot; as USR\nactor \&quot;Employee\\n(Rider)\&quot; as EMP\nactor \&quot;Shuttle Driver\&quot; as DRV\nactor \&quot;Shuttle Admin\&quot; as ADM\n\nEMP --|&gt; USR\nDRV --|&gt; USR\nADM --|&gt; USR\n\n&#39; ---------- Secondary actors (right) ----------\nactor \&quot;System Timer\&quot; as TMR\nactor \&quot;Module 4\\nSafety &amp; Tracking\&quot; as M4 &lt;&lt;system&gt;&gt;\nactor \&quot;Module 5\\nAnalytics\&quot; as M5 &lt;&lt;system&gt;&gt;\n\n&#39; ---------- Single system boundary ----------\nrectangle \&quot;Fleet &amp; Shuttle Booking System (Module 2)\&quot; {\n\n  usecase \&quot;Login\&quot; as UC_LOGIN\n  usecase \&quot;Register Account\&quot; as UC_REG\n  usecase \&quot;Verify Corporate Email\&quot; as UC_VERIFY\n\n  usecase \&quot;Search Trips\&quot; as UC_SEARCH\n  usecase \&quot;View Trip Details\&quot; as UC_DETAIL\n  usecase \&quot;Book Seat\&quot; as UC_BOOK\n  usecase \&quot;Check Seat Availability\&quot; as UC_AVAIL\n  usecase \&quot;Allocate Seats\&quot; as UC_ALLOC\n  usecase \&quot;Hold Seats Temporarily\&quot; as UC_HOLD\n  usecase \&quot;Select Seat Manually\&quot; as UC_SELECT\n  usecase \&quot;Join Waitlist\&quot; as UC_JOIN\n  usecase \&quot;View Waitlist Status\&quot; as UC_WSTATUS\n  usecase \&quot;View My Bookings\&quot; as UC_MY\n  usecase \&quot;Modify Booking\&quot; as UC_MOD\n  usecase \&quot;Cancel Booking\&quot; as UC_CANCEL\n  usecase \&quot;Release Seats\&quot; as UC_REL\n  usecase \&quot;Promote Waitlist (FIFO)\&quot; as UC_PROMO\n\n  usecase \&quot;Manage Vehicles\&quot; as UC_VEH\n  usecase \&quot;Generate Seat Layout\&quot; as UC_LAYOUT\n  usecase \&quot;Manage Shuttle Trips\&quot; as UC_TRIP\n  usecase \&quot;Assign Vehicle &amp; Driver\&quot; as UC_ASSIGN\n  usecase \&quot;View Occupancy /\\nBooking Report\&quot; as UC_REPORT\n  usecase \&quot;Compare FF vs BFD Packing\&quot; as UC_PACK\n\n  usecase \&quot;View Assigned Trips &amp;\\nPassenger List\&quot; as UC_DTRIPS\n  usecase \&quot;Start / Complete Trip\&quot; as UC_RUN\n\n  usecase \&quot;Release Expired Holds\&quot; as UC_EXPIRE\n}\n\n&#39; ---------- Associations ----------\nUSR -- UC_LOGIN\n\nEMP -- UC_REG\nEMP -- UC_SEARCH\nEMP -- UC_DETAIL\nEMP -- UC_BOOK\nEMP -- UC_WSTATUS\nEMP -- UC_MY\nEMP -- UC_MOD\nEMP -- UC_CANCEL\n\nADM -- UC_VEH\nADM -- UC_TRIP\nADM -- UC_REPORT\nADM -- UC_PACK\n\nDRV -- UC_DTRIPS\nDRV -- UC_RUN\n\nTMR -- UC_EXPIRE\nM4 -- UC_VERIFY\nM4 -- UC_RUN\nM5 -- UC_BOOK\nM5 -- UC_CANCEL\n\n&#39; ---------- Include (base ..&gt; included) ----------\nUC_REG    .&gt; UC_VERIFY : &lt;&lt;include&gt;&gt;\nUC_BOOK   .&gt; UC_AVAIL  : &lt;&lt;include&gt;&gt;\nUC_BOOK   .&gt; UC_ALLOC  : &lt;&lt;include&gt;&gt;\nUC_BOOK   .&gt; UC_HOLD   : &lt;&lt;include&gt;&gt;\nUC_MOD    .&gt; UC_AVAIL  : &lt;&lt;include&gt;&gt;\nUC_CANCEL .&gt; UC_REL    : &lt;&lt;include&gt;&gt;\nUC_VEH    .&gt; UC_LAYOUT : &lt;&lt;include&gt;&gt;\nUC_TRIP   .&gt; UC_ASSIGN : &lt;&lt;include&gt;&gt;\n\n&#39; ---------- Extend (extending ..&gt; base) ----------\nUC_SELECT .&gt; UC_BOOK   : &lt;&lt;extend&gt;&gt;\\n[employee picks seat]\nUC_JOIN   .&gt; UC_BOOK   : &lt;&lt;extend&gt;&gt;\\n[no seats available]\nUC_PROMO  .&gt; UC_CANCEL : &lt;&lt;extend&gt;&gt;\\n[seats freed and\\nwaitlist not empty]\n\n@endumlduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="WTEtIRPcTt_bubS7SYOW-1">
