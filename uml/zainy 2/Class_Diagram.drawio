  <diagram name="Page-1" id="c0nhz4a_cjKsDUzXB7Xp">
    <mxGraphModel dx="1613" dy="1154" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nclass FuelCostCalculator {\n  +calculate(distanceKm, kmPerLitre, pricePerLitre): number\n  +validateInputs(distance, kmPerL, price): void\n  +toLitres(distanceKm, kmPerLitre): number\n}\n\nclass CO2Calculator {\n  +calculateEmissions(litres, kgCO2PerLitre): number\n  +calculateAvoided(soloBaseline, actualCO2): number\n  +soloBaseline(participants, directRoutes): number\n  +validateFactor(factor): void\n}\n\nclass FairSplitEngine {\n  -epsilon: number\n  +computeMarginalCosts(route, passengers): Map\n  +detourWeightedSplit(totalCost, marginalCosts): Map\n  +largestRemainder(shares, total): Map\n  +applyFloor(weight): number\n  +applyMinimumFare(share): number\n  +shapleyValue(coalition, costFn): Map\n}\n\nclass LedgerService {\n  +postSettlement(tripId, splits): void\n  +topUp(accountId, amount, adminId): void\n  +redeemVoucher(code, userId): void\n  +getBalance(accountId): number\n  +getTransactions(accountId, cursor): list\n  +generateIdempotencyKey(tripId, userId): string\n}\n\nclass WalletAccount {\n  -id: uuid\n  -ownerType: enum\n  -ownerId: uuid\n  -currency: string\n  +getBalance(): number\n}\n\nclass LedgerEntry {\n  -id: uuid\n  -txnId: uuid\n  -accountId: uuid\n  -tripId: uuid\n  -userId: uuid\n  -amountMinor: number\n  -direction: enum\n  -reason: string\n  -idempotencyKey: string\n  -createdAt: Date\n}\n\nclass EmissionFactor {\n  -id: uuid\n  -fuelTypeId: uuid\n  -vehicleTypeId: uuid\n  -kgCO2ePerLitre: number\n  -kgCO2ePerKm: number\n  -source: string\n  -sourceYear: number\n  -region: string\n}\n\nclass FuelPrice {\n  -id: uuid\n  -fuelTypeId: uuid\n  -priceMinorPerLitre: number\n  -effectiveFrom: Date\n  +getCurrentPrice(fuelTypeId, date): number\n}\n\nclass FuelType {\n  -id: uuid\n  -code: string\n  -name: string\n}\n\nclass VehicleType {\n  -id: uuid\n  -name: string\n  -fuelTypeId: uuid\n  -avgKmPerLitre: number\n  -defaultOccupancy: number\n}\n\nclass VehicleRegistry {\n  -id: uuid\n  -ownerUserId: uuid\n  -vehicleTypeId: uuid\n  -regNo: string\n  -kmPerLitreOverride: number\n  -seats: number\n}\n\nclass GRIExporter {\n  +exportCSV(companyId, from, to): string\n  +exportPDF(companyId, from, to): Buffer\n  +logExport(adminId, period, hash): void\n  +validateAgainstSample(data): bool\n}\n\nclass TripEmissionSummary {\n  -tripId: uuid\n  -companyId: uuid\n  -distanceKm: number\n  -co2Kg: number\n  -co2AvoidedKg: number\n  -occupancy: number\n  -occurredAt: Date\n}\n\nclass Voucher {\n  -code: string\n  -companyId: uuid\n  -amountMinor: number\n  -expiresAt: Date\n  -redeemedBy: uuid\n  +isValid(): bool\n  +isExpired(): bool\n}\n\nFairSplitEngine --&gt; FuelCostCalculator : uses\nFairSplitEngine --&gt; CO2Calculator : uses\nLedgerService --&gt; LedgerEntry : creates\nLedgerService --&gt; WalletAccount : reads\nLedgerService --&gt; Voucher : redeems\nFuelCostCalculator --&gt; FuelPrice : reads\nFuelCostCalculator --&gt; VehicleRegistry : reads\nCO2Calculator --&gt; EmissionFactor : reads\nGRIExporter --&gt; TripEmissionSummary : reads\nGRIExporter --&gt; CO2Calculator : uses\nVehicleRegistry --&gt; VehicleType : is of\nVehicleType --&gt; FuelType : uses\nEmissionFactor --&gt; FuelType : applies to\nFuelPrice --&gt; FuelType : for\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="92cwZFiJctbq_Bu_RL-V-1">
