        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nentity COMPANIES {\n  * id : bigserial &lt;&lt;PK&gt;&gt;\n  --\n  name : text\n  email_domains : text[]\n  created_at : timestamptz\n}\n\nentity USERS {\n  * id : bigserial &lt;&lt;PK&gt;&gt;\n  --\n  company_id : bigint &lt;&lt;FK&gt;&gt;\n  email : citext\n  full_name : text\n  role : text\n  gender : text\n  created_at : timestamptz\n}\n\nentity TRIPS {\n  * id : bigserial &lt;&lt;PK&gt;&gt;\n  --\n  kind : text\n  company_id : bigint &lt;&lt;FK&gt;&gt;\n  driver_user_id : bigint &lt;&lt;FK&gt;&gt;\n  status : text\n  planned_start : timestamptz\n  started_at : timestamptz\n  ended_at : timestamptz\n}\n\nentity TRIP_PARTICIPANTS {\n  * trip_id : bigint &lt;&lt;FK&gt;&gt;\n  * user_id : bigint &lt;&lt;FK&gt;&gt;\n  --\n  role : text\n}\n\nentity TRACKING_POINTS {\n  * id : bigserial &lt;&lt;PK&gt;&gt;\n  --\n  trip_id : bigint &lt;&lt;FK&gt;&gt;\n  user_id : bigint &lt;&lt;FK&gt;&gt;\n  geom : geometry(Point,4326)\n  speed_mps : real\n  heading : real\n  accuracy_m : real\n  recorded_at : timestamptz\n  received_at : timestamptz\n}\n\nentity ROUTE_BOUNDARIES {\n  * trip_id : bigint &lt;&lt;PK,FK&gt;&gt;\n  --\n  geom : geometry(LineString,4326)\n  mild_threshold_m : int\n  severe_threshold_m : int\n  created_at : timestamptz\n}\n\nentity SOS_EVENTS {\n  * id : bigserial &lt;&lt;PK&gt;&gt;\n  --\n  trip_id : bigint &lt;&lt;FK&gt;&gt;\n  user_id : bigint &lt;&lt;FK&gt;&gt;\n  trigger : text\n  geom : geometry(Point,4326)\n  status : text\n  created_at : timestamptz\n  resolved_at : timestamptz\n  resolved_by : bigint &lt;&lt;FK&gt;&gt;\n  note : text\n}\n\nentity ANOMALY_LOG {\n  * id : bigserial &lt;&lt;PK&gt;&gt;\n  --\n  trip_id : bigint &lt;&lt;FK&gt;&gt;\n  user_id : bigint &lt;&lt;FK&gt;&gt;\n  level : text\n  distance_m : real\n  geom : geometry(Point,4326)\n  details : jsonb\n  created_at : timestamptz\n}\n\nentity VERIFIED_USERS {\n  * user_id : bigint &lt;&lt;PK,FK&gt;&gt;\n  --\n  corporate_email : citext\n  verified_at : timestamptz\n}\n\nentity OTP_REQUESTS {\n  * id : bigserial &lt;&lt;PK&gt;&gt;\n  --\n  user_id : bigint &lt;&lt;FK&gt;&gt;\n  email : citext\n  otp_hash : text\n  expires_at : timestamptz\n  attempts : int\n  consumed : boolean\n  created_at : timestamptz\n}\n\nentity SAFETY_PREFERENCES {\n  * user_id : bigint &lt;&lt;PK,FK&gt;&gt;\n  --\n  women_only : boolean\n  emergency_contact_name : text\n  emergency_contact_phone : text\n  emergency_contact_email : text\n}\n\nCOMPANIES ||--o{ USERS : employs\nCOMPANIES ||--o{ TRIPS : owns\nUSERS ||--o{ TRIP_PARTICIPANTS : joins\nTRIPS ||--o{ TRIP_PARTICIPANTS : has\nUSERS ||--o{ TRIPS : drives\nTRIPS ||--o{ TRACKING_POINTS : records\nTRIPS ||--|| ROUTE_BOUNDARIES : has\nTRIPS ||--o{ SOS_EVENTS : generates\nTRIPS ||--o{ ANOMALY_LOG : logs\nUSERS ||--o{ SOS_EVENTS : triggers\nUSERS ||--o{ ANOMALY_LOG : involved_in\nUSERS ||--o| VERIFIED_USERS : verified_as\nUSERS ||--o{ OTP_REQUESTS : requests\nUSERS ||--o| SAFETY_PREFERENCES : has\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="cah12aQAEpCPjTiD6Jb_-98">
