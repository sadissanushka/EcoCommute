  <diagram name="Page-1" id="dQegV4G2_3-tZYxTjo_u">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nparticipant \&quot;Mobile App\&quot; as MA\nparticipant \&quot;WebSocket Server\&quot; as WS\nparticipant \&quot;Anomaly Detector\&quot; as AD\nparticipant \&quot;Batch Ingestor\&quot; as BI\nparticipant \&quot;Database\&quot; as DB\nparticipant \&quot;SOS Service\&quot; as SS\nparticipant \&quot;Admin\&quot; as ADM\nparticipant \&quot;Emergency Contact\&quot; as EC\n\nnote over MA,EC: Trip start — WebSocket handshake\n\nMA -&gt; WS: connect(tripId, ws_ticket / JWT)\nWS -&gt; WS: validate JWT\nWS -&gt; DB: check trip_participants(userId, tripId)\nDB --&gt; WS: authorised\nWS -&gt; DB: getRoute(tripId) from route_boundaries\nDB --&gt; WS: routeLineString + thresholds\nWS --&gt; MA: {type: joined}\nWS --&gt; MA: last known location of participants\n\nnote over MA,EC: Heartbeat loop (every 30s)\n\nWS -&gt; MA: ping\nMA --&gt; WS: pong\nWS -&gt; WS: reset heartbeat timer\n\nnote over MA,EC: Normal GPS streaming loop (every 1–2s)\n\nMA -&gt; WS: {type: location, lat, lng, speed, heading, accuracy, ts}\nWS -&gt; WS: validate payload size and rate limit\nWS -&gt; BI: add(point)\nBI -&gt; BI: buffer point\nBI -&gt; DB: batch INSERT tracking_points (every 1–2s)\nWS --&gt; MA: broadcast location to room\nWS -&gt; AD: score(point, route)\nAD -&gt; AD: haversine distance calc\nAD --&gt; WS: NORMAL dist &lt; 250m\nWS -&gt; DB: INSERT anomaly_log (OK)\n\nnote over MA,EC: Connection drop and reconnect\n\nMA -&gt; WS: reconnect with backoff\nWS -&gt; WS: validate JWT\nWS --&gt; MA: joined + last known locations\n\nnote over MA,EC: Route deviation detected\n\nMA -&gt; WS: GPS point off-route\nWS -&gt; AD: score(point, route)\nAD -&gt; AD: consecutive counter = 3\nAD --&gt; WS: WARNING dist &gt; 250m\nWS --&gt; MA: {type: deviation, level: warning}\nWS -&gt; DB: INSERT anomaly_log (warning)\n\nWS -&gt; AD: score(point, route)\nAD -&gt; AD: consecutive counter = 6\nAD --&gt; WS: ADMIN_ALERT dist &gt; 400m\nWS --&gt; ADM: push admin alert\nWS -&gt; DB: INSERT anomaly_log (admin_alert)\n\nWS -&gt; AD: score(point, route)\nAD -&gt; AD: severe threshold crossed\nAD --&gt; WS: AUTO_SOS dist &gt; 2000m\nWS -&gt; SS: triggerAuto(tripId, location)\n\nnote over MA,EC: SOS processing\n\nSS -&gt; DB: INSERT sos_event (trigger=auto_anomaly)\nSS --&gt; MA: {type: sos} notify employee\nSS --&gt; ADM: notify admin via WebSocket + email\nSS --&gt; EC: email emergency contact\nSS -&gt; SS: start re-notify timer if unacknowledged\n\nADM -&gt; SS: acknowledge(eventId)\nSS -&gt; DB: UPDATE sos_event (status=acknowledged)\n\nADM -&gt; SS: resolve(eventId, note)\nSS -&gt; DB: UPDATE sos_event (status=resolved, resolved_at)\nSS --&gt; MA: notify employee SOS resolved\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="CEhFtMGhZtBDj-rYH-HT-108">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
