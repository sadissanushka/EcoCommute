  <diagram name="Page-1" id="QhSeHWUd5zes9DCdRKWZ">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nstart\n\n:Employee opens app;\n:Enter corporate email;\n\nif (Email domain valid?) then (yes)\n  :Send OTP via Nodemailer;\n  :Employee enters OTP;\n  if (OTP valid and not expired?) then (yes)\n    :Mark user as verified;\n    :Set verified=true in JWT;\n  else (no)\n    if (Attempts &gt;= 5?) then (yes)\n      :Lock OTP request;\n      stop\n    else (no)\n      :Increment attempt counter;\n      :Show error — try again;\n      stop\n    endif\n  endif\nelse (no)\n  :Reject — invalid domain;\n  stop\nendif\n\n:Employee sets safety preferences;\nnote right\n  women-only toggle\n  emergency contacts\nend note\n\n:Employee joins active trip;\n:Mobile app connects to WebSocket server;\n\nif (JWT valid?) then (yes)\n  if (User is trip participant?) then (yes)\n    :Server sends joined + last known locations;\n  else (no)\n    :Close connection 4403;\n    stop\n  endif\nelse (no)\n  :Reject with 401;\n  stop\nendif\n\n:Load route boundary from DB;\n:Start heartbeat timer (every 30s);\n\nrepeat\n\n  :Receive GPS point from mobile app;\n  :Validate payload size and rate limit;\n\n  if (Payload valid?) then (yes)\n    :Add point to batch buffer;\n    if (Buffer full or 1-2s elapsed?) then (yes)\n      :Batch INSERT to tracking_points;\n    endif\n    :Broadcast location to trip room;\n    :Score point against route (Haversine);\n\n    if (Distance &lt; mild threshold 250m?) then (yes)\n      :Reset consecutive counter;\n      :Log anomaly_log OK;\n      :State = NORMAL;\n\n    elseif (Distance &gt; mild threshold for 3+ points?) then (WARNING)\n      :State = WARNING;\n      :Send deviation warning to employee;\n      :Log anomaly_log warning;\n\n      if (Distance &gt; 400m for 6+ points?) then (yes)\n        :State = ADMIN_ALERT;\n        :Push silent alert to admin;\n        :Log anomaly_log admin_alert;\n\n        if (Distance &gt; severe threshold 2000m?) then (yes)\n          :State = AUTO_SOS;\n          :Create sos_event trigger=auto_anomaly;\n          :Notify admin via WebSocket + email;\n          :Notify emergency contact via email;\n          :Start re-notify timer;\n\n          if (Admin acknowledges?) then (yes)\n            :UPDATE sos_event status=acknowledged;\n\n            if (Admin resolves?) then (yes)\n              :UPDATE sos_event status=resolved;\n              :Notify employee SOS resolved;\n            else (no)\n              :Wait for resolution;\n            endif\n\n          else (no)\n            :Re-notify admin after T minutes;\n          endif\n\n        else (no)\n          :Stay in ADMIN_ALERT state;\n        endif\n\n      else (no)\n        :Stay in WARNING state;\n      endif\n\n    endif\n\n  else (no)\n    :Drop invalid point;\n    :Log warning;\n  endif\n\n  :Check heartbeat;\n  if (Pong received?) then (yes)\n    :Reset heartbeat timer;\n  else (no)\n    if (Missed 2 pongs?) then (yes)\n      :Terminate connection;\n      :Client reconnects with backoff;\n    endif\n  endif\n\n  :Check stall condition;\n  if (Speed &lt; 1m/s for &gt; 5 min and not at stop?) then (yes)\n    :Log anomaly_log stall;\n    :Notify admin — stall detected;\n  endif\n\n  :Check trip end condition;\n  if (Within 150m of destination?) then (yes)\n    :UPDATE trips status=completed;\n    :Publish trip.completed event;\n    :Close WebSocket room;\n    :Stop anomaly detector;\n    stop\n  endif\n\nrepeat while (Trip still active?)\n\nif (Employee presses SOS manually?) then (yes)\n  :Show 3-second hold confirmation;\n  if (Confirmed?) then (yes)\n    :POST /sos with last known location;\n    :Create sos_event trigger=manual;\n    :Notify admin + emergency contact;\n  else (no)\n    :Cancel SOS;\n  endif\nendif\n\n:Connection dropped unexpectedly;\nif (Trip end event received?) then (no)\n  :Log trip_end anomaly;\n  :Notify admin — incomplete trip;\nelse (yes)\n  :Normal trip end;\nendif\n\nstop\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="jZ9i-DIxFfKRTjyeClpX-1">
