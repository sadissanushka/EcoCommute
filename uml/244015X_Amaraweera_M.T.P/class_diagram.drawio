        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nclass WebSocketServer {\n  -port: number\n  -sessions: Map\n  -jwtSecret: string\n  +handleConnection(ws)\n  +broadcast(tripId, data)\n  +authenticate(token): bool\n  +heartbeat()\n  +reconnect(tripId, userId)\n  +sendLastKnownLocation(tripId)\n}\n\nclass AnomalyDetector {\n  -threshold1: number\n  -threshold2: number\n  -threshold3: number\n  -windowCounter: number\n  -state: enum\n  +score(point, route): level\n  +haversine(p1, p2): number\n  +detectStall(points): bool\n  +detectTripEnd(point, destination): bool\n  +escalate(): level\n  +deEscalate()\n  +reset()\n}\n\nclass TrackingPoint {\n  -id: uuid\n  -tripId: uuid\n  -userId: uuid\n  -lat: number\n  -lon: number\n  -speedMps: number\n  -heading: number\n  -accuracyM: number\n  -recordedAt: Date\n  +toGeoJSON(): object\n}\n\nclass SOSService {\n  -alertLevel: enum\n  -notifier: Notifier\n  +triggerManual(userId, loc)\n  +triggerAuto(tripId, loc)\n  +acknowledge(eventId, adminId)\n  +resolve(eventId, adminId, note)\n  +notifyContacts(event)\n  +reNotifyIfUnacknowledged(eventId)\n}\n\nclass SOSEvent {\n  -id: uuid\n  -tripId: uuid\n  -userId: uuid\n  -triggerType: enum\n  -location: Point\n  -status: enum\n  -resolvedAt: Date\n  -resolvedBy: uuid\n  -note: string\n  +isResolved(): bool\n  +isAcknowledged(): bool\n}\n\nclass VerificationService {\n  -otpStore: Map\n  -emailer: Nodemailer\n  +requestOTP(email)\n  +verifyOTP(email, otp): bool\n  +setVerified(userId)\n  +generateOTP(): string\n  +isRateLimited(email): bool\n  +invalidatePrevious(email)\n}\n\nclass OTPRequest {\n  -id: uuid\n  -userId: uuid\n  -email: string\n  -otpHash: string\n  -expiresAt: Date\n  -attempts: number\n  -consumed: boolean\n  -createdAt: Date\n  +isExpired(): bool\n  +isConsumed(): bool\n  +incrementAttempts()\n}\n\nclass User {\n  -id: uuid\n  -companyId: uuid\n  -email: string\n  -fullName: string\n  -role: enum\n  -gender: string\n  -isVerified: bool\n  +getPreferences(): object\n}\n\nclass SafetyPreferences {\n  -userId: uuid\n  -womenOnly: bool\n  -emergencyContactName: string\n  -emergencyContactPhone: string\n  -emergencyContactEmail: string\n}\n\nclass RouteBoundary {\n  -tripId: uuid\n  -routeLine: LineString\n  -mildThresholdM: number\n  -severeThresholdM: number\n  -createdAt: Date\n}\n\nclass BatchIngestor {\n  -buffer: TrackingPoint[]\n  -flushIntervalMs: number\n  +add(point)\n  +flush()\n  +batchInsert(points)\n}\n\nWebSocketServer --&gt; AnomalyDetector : uses\nWebSocketServer --&gt; BatchIngestor : delegates GPS insert\nWebSocketServer --&gt; TrackingPoint : creates\nAnomalyDetector --&gt; SOSService : triggers\nAnomalyDetector --&gt; RouteBoundary : reads\nSOSService --&gt; SOSEvent : creates\nSOSService --&gt; SOSEvent : updates\nVerificationService --&gt; OTPRequest : creates\nVerificationService --&gt; User : verifies\nUser \&quot;1\&quot; --&gt; \&quot;1\&quot; SafetyPreferences : has\nBatchIngestor --&gt; TrackingPoint : batches\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="5VmjTi8bgx9kJ_F7p4DF-1">
