  <diagram name="Page-1" id="jo8oOOuA5t0_L2oE58Bx">
    <mxGraphModel dx="683" dy="951" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n  autonumber\n  actor U as Employee\n  participant GW as API Gateway\n  participant MC as MatchController\n  participant MS as MatchingService\n  participant MR as MatchRepository\n  participant SO as NearestNeighbourOrderer\n  participant TO as TwoOptImprover\n  participant RS as RouteService\n  participant BP as RouteBoundariesPublisher\n  participant M4 as Module 4 Safety\n  participant M3 as Module 3 Wallet\n \n  U-&gt;&gt;GW: POST /matches/id/confirm\n  GW-&gt;&gt;MC: forward with verified JWT\n  MC-&gt;&gt;MS: confirm(matchId)\n  MS-&gt;&gt;MR: load match, check status is proposed and seat free\n  alt not proposed or no seat left\n    MS--&gt;&gt;MC: conflict\n    MC--&gt;&gt;U: 409 MATCH_UNAVAILABLE\n  else confirmable\n    MS-&gt;&gt;SO: order(driver origin, stops)\n    loop greedy build\n      SO-&gt;&gt;RS: distanceM(current, each unvisited stop)\n      RS--&gt;&gt;SO: route distances\n    end\n    SO-&gt;&gt;TO: improve(initial tour, time budget)\n    loop until no improving swap or budget used\n      TO-&gt;&gt;RS: distanceM for reversed segments\n      RS--&gt;&gt;TO: route distances\n    end\n    TO--&gt;&gt;SO: improved stop order\n    SO--&gt;&gt;MS: ordered stops\n    MS-&gt;&gt;RS: routeVia(origin, ordered stops, destination)\n    RS--&gt;&gt;MS: planned route polyline\n    MS-&gt;&gt;MR: updateStatus(confirmed) and savePlannedRoute\n    MS-&gt;&gt;BP: publish(tripId, polyline)\n    BP-&gt;&gt;M4: route_boundaries polyline for trip\n    M4--&gt;&gt;BP: stored\n    MS--&gt;&gt;MC: confirmed match with stop order\n    MC--&gt;&gt;U: 200 confirmed\n    Note over M3: Settlement later reads the final route distance via /route\n  end&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="zldtQE4rqisCdFYgGSNb-1">
