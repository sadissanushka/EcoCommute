  <diagram name="Page-1" id="P7VxoDYX-oGH1IeoD7uP">
    <mxGraphModel dx="2732" dy="3804" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n  autonumber\n  actor C as Client or Module 2 or 3\n  participant GW as API Gateway\n  participant RC as RouteController\n  participant RS as RouteService\n  participant SN as NearestNodeSnapper\n  participant DB as PostGIS\n  participant RT as Router (Dijkstra or A*)\n  participant G as RoadGraph in memory\n \n  C-&gt;&gt;GW: POST /route origin, destination, criteria, algorithm\n  GW-&gt;&gt;GW: verify JWT, rate limit, add request id\n  GW-&gt;&gt;RC: forward request\n  RC-&gt;&gt;RC: validate lat and lng ranges\n  alt invalid input\n    RC--&gt;&gt;C: 400 VALIDATION_ERROR\n  else valid input\n    RC-&gt;&gt;RS: route(origin, destination, opts)\n    RS-&gt;&gt;SN: snap(origin) and snap(destination)\n    SN-&gt;&gt;DB: nearest-node KNN query on road_nodes\n    DB--&gt;&gt;SN: nearest node ids\n    SN--&gt;&gt;RS: originNode, destinationNode\n    alt same node\n      RS--&gt;&gt;RC: zero-length RouteResult\n    else different nodes\n      RS-&gt;&gt;RT: findRoute(originNode, destinationNode, criteria)\n      loop until target popped or heap empty\n        RT-&gt;&gt;G: neighbours(node)\n        G--&gt;&gt;RT: outgoing edges, oneway respected\n      end\n      alt target reached\n        RT--&gt;&gt;RS: RouteResult with path, distance, time\n        RS--&gt;&gt;RC: RouteResult with polyline\n        RC--&gt;&gt;C: 200 distanceM, etaSeconds, path\n      else unreachable\n        RT--&gt;&gt;RS: NoRouteError\n        RS--&gt;&gt;RC: NoRouteError\n        RC--&gt;&gt;C: 404 NO_ROUTE\n      end\n    end\n  end&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="pyH6Bpp82HYenT80fwKI-1">
