      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n  autonumber\n  actor R as Rider\n  participant GW as API Gateway\n  participant RC as RideController\n  participant RR as RideRepository\n  participant MC as MatchController\n  participant MS as MatchingService\n  participant WF as WomenOnlyFilter\n  participant DC as DetourCalculator\n  participant RS as RouteService\n  participant OS as OverlapScorer\n  participant GS as GreedySelector\n  participant MR as MatchRepository\n \n  R-&gt;&gt;GW: POST /rides kind request, origin, destination, window\n  GW-&gt;&gt;RC: forward with verified JWT\n  RC-&gt;&gt;RC: validate input\n  RC-&gt;&gt;RR: saveRequest(request)\n  RR--&gt;&gt;RC: rideId\n  RC--&gt;&gt;R: 201 rideId\n \n  R-&gt;&gt;GW: GET /matches?rideId\n  GW-&gt;&gt;MC: forward\n  MC-&gt;&gt;MS: findMatches(rideId)\n  MS-&gt;&gt;RR: findOpenOffers(time window)\n  RR--&gt;&gt;MS: candidate offers\n  loop each candidate offer\n    MS-&gt;&gt;WF: allows(offer, request)\n    alt women-only mismatch\n      WF--&gt;&gt;MS: false, skip candidate\n    else allowed\n      WF--&gt;&gt;MS: true\n      MS-&gt;&gt;DC: detour(offer, request)\n      DC-&gt;&gt;RS: route(offer origin to offer destination)\n      RS--&gt;&gt;DC: direct route\n      DC-&gt;&gt;RS: routeVia(offer origin, pickup, dropoff, offer destination)\n      RS--&gt;&gt;DC: route with rider\n      DC--&gt;&gt;MS: detourAddedM\n      alt detour above configured limit\n        MS-&gt;&gt;MS: reject candidate\n      else within limit\n        MS-&gt;&gt;OS: overlapPct(direct route, request route)\n        OS--&gt;&gt;MS: overlapPct\n      end\n    end\n  end\n  MS-&gt;&gt;GS: select(scored candidates, capacity)\n  GS--&gt;&gt;MS: ranked matches\n  MS-&gt;&gt;MR: saveAll(matches with status proposed)\n  MS--&gt;&gt;MC: ranked matches with approximate pickup points\n  MC--&gt;&gt;R: 200 matches, overlap %, detour added&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="rDNWjkhZ2mYUgx8jeU-_-1">
