  <diagram name="Page-1" id="AQW29DLTzljxBxDrNaI9">
    <mxGraphModel dx="1212" dy="849" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n\ntitle Module 5 - Admin &amp; Government Dashboards\\n+ Analytics/Privacy Engine\n\nskinparam classAttributeIconSize 0\nskinparam shadowing false\nskinparam linetype ortho\nskinparam backgroundColor white\n\n&#39; ONE SYSTEM BOUNDARY\n\npackage \&quot;Admin &amp; Government Dashboards + Analytics/Privacy Engine\&quot; {\n\n    &#39; ========================\n    &#39; USER CLASSES\n    &#39; ========================\n\n    class CompanyAdmin {\n        - adminId: UUID\n        - companyId: UUID\n        + viewDashboard(): void\n        + exportReport(): void\n        + manageConsent(): void\n    }\n\n    class GovernmentPolicymaker {\n        - policymakerId: UUID\n        - agencyName: String\n        + viewCityAnalytics(): void\n        + selectPrivacyLevel(): void\n    }\n\n    &#39; ========================\n    &#39; DASHBOARD CLASSES\n    &#39; ========================\n\n    class AdminDashboard {\n        - dashboardId: UUID\n        - companyId: UUID\n        + viewTripStatistics(): void\n        + viewOccupancy(): void\n        + viewFuelAnalytics(): void\n        + viewCO2Analytics(): void\n        + filterAnalytics(): void\n    }\n\n    class GovernmentDashboard {\n        - dashboardId: UUID\n        - selectedZone: String\n        + viewCityStatistics(): void\n        + viewCommuteHeatmap(): void\n        + viewEmissions(): void\n    }\n\n    &#39; ========================\n    &#39; ANALYTICS ENGINE\n    &#39; ========================\n\n    class AnalyticsEngine {\n        + aggregateTripData(): void\n        + calculateOccupancy(): Double\n        + aggregateFuelData(): void\n        + aggregateCO2Data(): void\n        + refreshMaterializedViews(): void\n    }\n\n    class ETLScheduler {\n        - schedule: String\n        + executeETL(): void\n        + refreshAnalytics(): void\n    }\n\n    &#39; ========================\n    &#39; PRIVACY ENGINE\n    &#39; ========================\n\n    class PrivacyEngine {\n        - minimumGroupSize: Integer\n        + applyKAnonymity(): void\n        + applyDifferentialPrivacy(): void\n        + validateConsent(): Boolean\n        + generatePrivateAnalytics(): void\n    }\n\n    class PrivacyBudget {\n        - totalEpsilon: Double\n        - usedEpsilon: Double\n        + checkBudget(): Boolean\n        + consumeBudget(): void\n    }\n\n    &#39; ========================\n    &#39; REPORT GENERATION\n    &#39; ========================\n\n    class ReportService {\n        + generateReport(): void\n        + exportCSV(): File\n        + exportPDF(): File\n        + generateScope3Report(): File\n    }\n\n    &#39; ========================\n    &#39; RELATIONSHIPS\n    &#39; ========================\n\n    CompanyAdmin --&gt; AdminDashboard : accesses\n\n    GovernmentPolicymaker --&gt; GovernmentDashboard : accesses\n\n    AdminDashboard --&gt; AnalyticsEngine : requests data\n\n    AdminDashboard --&gt; ReportService : generates reports\n\n    GovernmentDashboard --&gt; PrivacyEngine : requests private data\n\n    PrivacyEngine --&gt; AnalyticsEngine : gets aggregated data\n\n    PrivacyEngine --&gt; PrivacyBudget : manages\n\n    ETLScheduler --&gt; AnalyticsEngine : triggers\n\n    ReportService --&gt; AnalyticsEngine : retrieves metrics\n\n}\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="Vhy3rGgZC9i8pkmaGcxN-41">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
