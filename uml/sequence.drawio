  <diagram name="Page-1" id="km1EV02kSJCUN1P73aye">
    <mxGraphModel dx="1493" dy="1046" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n\ntitle Module 5 - Admin &amp; Government Dashboards\\n+ Analytics/Privacy Engine\n\nautonumber\n\nskinparam backgroundColor white\nskinparam sequenceMessageAlign center\nskinparam responseMessageBelowArrow true\nskinparam shadowing false\n\nactor \&quot;Company\\nAdministrator\&quot; as Admin\nactor \&quot;Government\\nPolicymaker\&quot; as Gov\n\nparticipant \&quot;Web Dashboard\\n(React / Next.js)\&quot; as UI\nparticipant \&quot;Analytics API\\n(Node.js / Express)\&quot; as API\nparticipant \&quot;Access Control\\nService\&quot; as Auth\nparticipant \&quot;Analytics Engine\&quot; as Analytics\ndatabase \&quot;PostgreSQL\\nMaterialized Views\&quot; as DB\nparticipant \&quot;Privacy Engine\&quot; as Privacy\nparticipant \&quot;K-Anonymity\\nService\&quot; as KAnon\nparticipant \&quot;Differential Privacy\\nService\&quot; as DP\nparticipant \&quot;Privacy Budget\\nManager\&quot; as Budget\nparticipant \&quot;Report Service\&quot; as Report\n\n== Company Admin Dashboard ==\n\nAdmin -&gt; UI: Login and Open Dashboard\nactivate UI\n\nUI -&gt; API: Request Company Analytics\nactivate API\n\nAPI -&gt; Auth: Validate JWT and Admin Role\nactivate Auth\nAuth --&gt; API: Authorization Result\ndeactivate Auth\n\nalt Authorized Administrator\n\n    API -&gt; Analytics: Get Company Analytics\n    activate Analytics\n\n    Analytics -&gt; DB: Query Aggregated Metrics\n    activate DB\n\n    DB --&gt; Analytics: Trip, Occupancy,\\nFuel and CO2 Data\n    deactivate DB\n\n    Analytics --&gt; API: Company Analytics\n    deactivate Analytics\n\n    API --&gt; UI: Return Dashboard Data\n\n    UI --&gt; Admin: Display KPI Cards and Charts\n\n    opt Apply Filters\n\n        Admin -&gt; UI: Select Date / Department\n\n        UI -&gt; API: Request Filtered Analytics\n\n        API -&gt; Analytics: Get Filtered Data\n        activate Analytics\n\n        Analytics -&gt; DB: Query Filtered Metrics\n        activate DB\n\n        DB --&gt; Analytics: Filtered Results\n        deactivate DB\n\n        Analytics --&gt; API: Filtered Analytics\n        deactivate Analytics\n\n        API --&gt; UI: Return Filtered Data\n\n        UI --&gt; Admin: Update Dashboard\n\n    end\n\n    opt Export Report\n\n        Admin -&gt; UI: Export CSV / PDF\n\n        UI -&gt; API: Request Report Export\n\n        API -&gt; Report: Generate Analytics Report\n        activate Report\n\n        Report -&gt; DB: Fetch Report Data\n        activate DB\n\n        DB --&gt; Report: Aggregated Metrics\n        deactivate DB\n\n        Report --&gt; API: Generated CSV / PDF\n        deactivate Report\n\n        API --&gt; UI: Download File\n\n        UI --&gt; Admin: Report Downloaded\n\n    end\n\nelse Unauthorized\n\n    API --&gt; UI: 403 Forbidden\n\n    UI --&gt; Admin: Access Denied\n\nend\n\ndeactivate API\ndeactivate UI\n\n\n== Government Dashboard ==\n\nGov -&gt; UI: Open Government Dashboard\nactivate UI\n\nGov -&gt; UI: Select Zone, Date and Epsilon\n\nUI -&gt; API: Request City-Level Analytics\nactivate API\n\nAPI -&gt; Auth: Validate Policymaker Role\nactivate Auth\n\nAuth --&gt; API: Authorization Result\ndeactivate Auth\n\nalt Authorized Policymaker\n\n    API -&gt; Privacy: Request Private Analytics\n    activate Privacy\n\n    Privacy -&gt; Privacy: Validate Company Opt-in Consent\n\n    alt Consent Available\n\n        Privacy -&gt; DB: Fetch Consented Aggregated Data\n        activate DB\n\n        DB --&gt; Privacy: City-Level Metrics\n        deactivate DB\n\n        Privacy -&gt; KAnon: Apply K-Anonymity\n        activate KAnon\n\n        KAnon -&gt; KAnon: Generalize Data\n\n        KAnon -&gt; KAnon: Suppress Groups Below K\n\n        KAnon --&gt; Privacy: Anonymized Data\n        deactivate KAnon\n\n        Privacy -&gt; Budget: Check Epsilon Budget\n        activate Budget\n\n        Budget --&gt; Privacy: Remaining Budget\n        deactivate Budget\n\n        alt Sufficient Privacy Budget\n\n            Privacy -&gt; DP: Apply Laplace Mechanism\n            activate DP\n\n            DP -&gt; DP: Calculate Sensitivity\n\n            DP -&gt; DP: Generate Laplace Noise\n\n            DP -&gt; DP: Add Noise to Aggregates\n\n            DP --&gt; Privacy: Privacy-Protected Data\n            deactivate DP\n\n            Privacy -&gt; Budget: Record Epsilon Usage\n            activate Budget\n\n            Budget --&gt; Privacy: Budget Updated\n            deactivate Budget\n\n            Privacy --&gt; API: Private City Analytics\n\n            API --&gt; UI: Return Protected Metrics\n\n            UI --&gt; Gov: Display Heatmaps,\\nCommute and CO2 Statistics\n\n        else Privacy Budget Exceeded\n\n            Privacy --&gt; API: Budget Exceeded\n\n            API --&gt; UI: Privacy Limit Reached\n\n            UI --&gt; Gov: Display Error Message\n\n        end\n\n    else Consent Not Available\n\n        Privacy --&gt; API: Data Sharing Not Allowed\n\n        API --&gt; UI: No Available Data\n\n        UI --&gt; Gov: Display No Data Message\n\n    end\n\n    deactivate Privacy\n\nelse Unauthorized\n\n    API --&gt; UI: 403 Forbidden\n\n    UI --&gt; Gov: Access Denied\n\nend\n\ndeactivate API\ndeactivate UI\n\n\n== Automated Analytics Processing ==\n\nparticipant \&quot;ETL Scheduler\\n(Cron / pg_cron)\&quot; as Scheduler\n\nScheduler -&gt; Analytics: Trigger Scheduled Aggregation\nactivate Analytics\n\nAnalytics -&gt; Analytics: Extract Trip, Booking,\\nWallet and Carbon Data\n\nAnalytics -&gt; Analytics: Calculate Trip Counts,\\nOccupancy, Fuel and CO2\n\nAnalytics -&gt; DB: Update Aggregated Data\nactivate DB\n\nDB --&gt; Analytics: Aggregated Data Stored\ndeactivate DB\n\nAnalytics -&gt; DB: Refresh Materialized Views\nactivate DB\n\nDB --&gt; Analytics: Views Refreshed\ndeactivate DB\n\nAnalytics --&gt; Scheduler: ETL Job Completed\ndeactivate Analytics\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="Abdz5qBmSx2ngeSFot34-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
