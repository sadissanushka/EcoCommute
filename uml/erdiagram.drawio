        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n  USER ||--o{ RIDE_OFFER : posts\n  USER ||--o{ RIDE_REQUEST : submits\n  RECURRING_SCHEDULE |o--o{ RIDE_OFFER : repeats\n  RECURRING_SCHEDULE |o--o{ RIDE_REQUEST : repeats\n  RIDE_OFFER ||--o{ MATCH : \&quot;is matched in\&quot;\n  RIDE_REQUEST ||--o{ MATCH : \&quot;is matched in\&quot;\n  MATCH ||--o| PICKUP_STOP : yields\n  RIDE_OFFER ||--o{ PICKUP_STOP : orders\n  RIDE_OFFER ||--o| ROUTE_BOUNDARY : publishes\n  ROAD_NODE ||--o{ ROAD_EDGE : \&quot;starts\&quot;\n  ROAD_NODE ||--o{ ROAD_EDGE : \&quot;ends\&quot;\n\n  USER {\n    uuid user_id PK\n    string corporate_email UK\n    boolean is_verified\n    string gender\n  }\n  ROAD_NODE {\n    bigint node_id PK\n    bigint osm_id UK\n    geometry geom\n  }\n  ROAD_EDGE {\n    bigint edge_id PK\n    bigint from_node FK\n    bigint to_node FK\n    float length_m\n    float speed_kmh\n    boolean one_way\n    float travel_time_s\n    geometry geom\n  }\n  RECURRING_SCHEDULE {\n    uuid schedule_id PK\n    smallint days_mask\n    time depart_time\n    date valid_from\n    date valid_to\n  }\n  RIDE_OFFER {\n    uuid offer_id PK\n    uuid driver_id FK\n    uuid schedule_id FK\n    geometry origin\n    geometry destination\n    timestamp depart_at\n    smallint seats_free\n    float max_detour_pct\n    boolean women_only\n    string status\n  }\n  RIDE_REQUEST {\n    uuid request_id PK\n    uuid rider_id FK\n    uuid schedule_id FK\n    geometry origin\n    geometry destination\n    timestamp window_start\n    timestamp window_end\n    boolean women_only\n    string status\n  }\n  MATCH {\n    uuid match_id PK\n    uuid offer_id FK\n    uuid request_id FK\n    float overlap_score\n    float detour_m\n    float detour_pct\n    string status\n    timestamp created_at\n  }\n  PICKUP_STOP {\n    uuid stop_id PK\n    uuid match_id FK\n    uuid offer_id FK\n    smallint seq_no\n    geometry approx_point\n  }\n  ROUTE_BOUNDARY {\n    uuid boundary_id PK\n    uuid offer_id FK\n    geometry route_line\n  }&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="y5hs0kPYc6wmsH_AMZfA-1">
