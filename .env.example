# ==============================================================================
# Corporate Employee Shuttle Platform - Shared Environment Variables (.env.example)
# Group 05 "Stack Kings"
# ==============================================================================

# Database (PostgreSQL + PostGIS)
POSTGRES_DB=corporate_shuttle
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DATABASE_URL=postgres://postgres:postgres@localhost:5432/corporate_shuttle

# Authentication & JWT Secrets
JWT_SECRET=super-secret-jwt-key-for-dev-change-in-prod-2026!
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super-secret-refresh-key-for-dev-2026!
JWT_REFRESH_EXPIRES_IN=7d

# Microservice Ports
GATEWAY_PORT=8080
AUTH_PORT=3001
BOOKING_PORT=3002
ROUTING_PORT=3000
WALLET_PORT=3003
SAFETY_PORT=3004
ANALYTICS_PORT=3005

# Service Internal URLs (for Gateway / Local proxying)
AUTH_SERVICE_URL=http://localhost:3001
BOOKING_SERVICE_URL=http://localhost:3002
ROUTING_SERVICE_URL=http://localhost:3000
WALLET_SERVICE_URL=http://localhost:3003
SAFETY_SERVICE_URL=http://localhost:3004
ANALYTICS_SERVICE_URL=http://localhost:3005

# Environment Mode
NODE_ENV=development
CORS_ORIGIN=*
